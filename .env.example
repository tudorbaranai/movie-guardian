# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# Restart the dev server after changing anything here.

# TMDB "API Read Access Token" (the long eyJ... one, not the short API key). Server-only.
TMDB_ACCESS_TOKEN=

# Supabase project URL (ends at .supabase.co) and the publishable key (sb_publishable_...).
# Both are safe in the browser; Row Level Security protects the data.
# Never put the secret key (sb_secret_...) anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel AI Gateway key for the movie assistant. Server-only.
# Leave it empty and the site still works; the chat panel just says it is switched off.
AI_GATEWAY_API_KEY=

# Optional. Leave commented out to use the defaults in lib/ai.ts.
# AI_MODEL=
# AI_FALLBACK_MODELS=
# AI_TOOL_ROUNDS=0
# AI_REASONING_EFFORT=
